{
  "manifest_version": 3,
  "name": "Spectrum",
  "version": "1.0.0",
  "description": "Real-time bias detection, claim verification, and cross-spectrum perspectives for any news article. Identifies loaded language, unsupported claims, and framing patterns across the political spectrum.",
  "homepage_url": "https://spectrum-research.web.app",
  "permissions": ["storage", "activeTab", "alarms", "tabs", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": [
      "shared/constants.js",
      "shared/storage.js",
      "shared/labels.js",
      "shared/credibility.js",
      "shared/stateMedia.js",
      "content/article-extractor.js",
      "content/youtube-detector.js",
      "content/content-script.js"
    ],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["deep-analysis.html", "deep-analysis/*", "shared/labels.js"],
    "matches": ["<all_urls>"]
  }]
}
